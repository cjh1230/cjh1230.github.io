---
import type { GetStaticPaths } from 'astro'
import PageLayout from '@/layouts/PageLayout.astro'
import { getAllCategories, getOldestPosts, slugify } from '@/utils/content'
import Timeline from '@/components/Timeline.astro'

export const getStaticPaths = (async () => {
  const allCategories = await getAllCategories()

  return allCategories.map((category) => {
    return {
      params: {
        category: category.slug,
      },
      props: { category },
    }
  })
}) satisfies GetStaticPaths

interface Props {
  category: {
    name: string
    slug: string
    count: number
  }
}

const { category } = Astro.props

const oldestPosts = await getOldestPosts().then((posts) => {
  return posts.filter((post) => post.data.category && slugify(post.data.category) === category.slug)
})
---

<PageLayout title={`分类 · ${category.name}`}>
  <header class="border-b border-primary">
    <div class="max-w-[1100px] mx-auto px-4 md:px-8 py-10 lg:py-14">
      <div class="label">Channel / 分类</div>
      <div class="mt-4 flex flex-wrap items-end justify-between gap-6">
        <h1 class="text-4xl md:text-5xl font-bold tracking-[-0.03em]">{category.name}</h1>
        <span class="label num">{category.count} entries</span>
      </div>
    </div>
  </header>

  <div class="max-w-[1100px] mx-auto px-4 md:px-8 py-8">
    <Timeline posts={oldestPosts} />
  </div>
</PageLayout>
