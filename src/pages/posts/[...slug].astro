---
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import MarkdownLayout from '@/layouts/MarkdownLayout.astro'
import { getSortedPosts, slugify } from '@/utils/content'
import MarkdownWrapper from '@/components/MarkdownWrapper.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import { PostToc } from '@/components/post/PostToc'
import PostMetaInfo from '@/components/post/PostMetaInfo.astro'
import PostArchiveInfo from '@/components/post/PostArchiveInfo.astro'
import { ReadingProgress } from '@/components/post/ReadingProgress'
import Outdate from '@/components/post/Outdate.astro'
import PostNav from '@/components/post/PostNav.astro'
import { Comments } from '@/components/comment'
import { ActionAside } from '@/components/post/ActionAside'
import { PostCopyright } from '@/components/post/PostCopyright'
import { getIsoDate } from '@/utils/date'

export const getStaticPaths = (async () => {
  const sortedPosts = await getSortedPosts()

  return sortedPosts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      current: post,
      prev: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined,
      next: index > 0 ? sortedPosts[index - 1] : undefined,
    },
  }))
}) satisfies GetStaticPaths

interface Props {
  current: CollectionEntry<'posts'>
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
}

const { current, prev, next } = Astro.props

const { headings, Content, remarkPluginFrontmatter } = await current.render()

const hasMath = /(?<!\\)\$/u.test(current.body ?? '')

// On small screens the sticky sidebar is hidden; give readers a native
// collapsible outline instead of a third-party drawer.
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3)

const mdSlug = `/posts/${current.slug}`

const mdDescription = concat(current.data.category || '', current.data.tags.join(', '))

function concat(str1: string, str2: string, sep = ' / ') {
  if (str1 && str2) return str1 + sep + str2
  if (str1) return str1
  if (str2) return str2
  return ''
}

const lastMod = current.data.lastMod || current.data.date
---

<MarkdownLayout
  hasMath={hasMath}
  title={current.data.title}
  description={current.data.summary}
  image={current.data.cover}
  mdTitle={current.data.title}
  mdDescription={mdDescription}
  mdSlug={mdSlug}
>
  <div class="max-w-[1100px] mx-auto px-4 md:px-8">
    <header class="py-8 md:py-10 lg:py-14 border-b border-primary">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 label">
        <a class="transition-colors hover:text-accent-ink" href="/">Index</a>
        <span aria-hidden>/</span>
        {
          current.data.category && (
            <>
              <a
                class="transition-colors hover:text-accent-ink"
                href={`/categories/${slugify(current.data.category)}`}
              >
                {current.data.category}
              </a>
              <span aria-hidden>/</span>
            </>
          )
        }
        <span class="num">{getIsoDate(current.data.date)}</span>
      </div>

      <h1
        class="mt-5 md:mt-6 max-w-[22ch] text-3xl md:text-[2.75rem] font-bold leading-[1.1] tracking-[-0.025em]"
      >
        {current.data.title}
      </h1>

      {
        current.data.summary && (
          <p class="mt-4 max-w-[62ch] text-sm md:text-base leading-relaxed text-secondary">
            {current.data.summary}
          </p>
        )
      }

      <div class="mt-6 space-y-2">
        <PostMetaInfo
          date={current.data.date}
          lastMod={current.data.lastMod}
          words={remarkPluginFrontmatter.words}
          readingMinutes={remarkPluginFrontmatter.readingMinutes}
        />
        <PostArchiveInfo category={current.data.category} tags={current.data.tags} />
      </div>

      {
        lastMod && (
          <div class="mt-6">
            <Outdate lastMod={lastMod} />
          </div>
        )
      }

      {
        tocHeadings.length > 0 && (
          <details class="sheet-details mt-6 border-t border-primary lg:hidden">
            <summary class="flex min-h-11 select-none items-center gap-3">
              <span class="label">目录 / Contents</span>
              <span class="h-px flex-1 bg-[rgb(var(--color-border-primary))]" aria-hidden="true" />
              <span class="mono num text-[11px] text-secondary">{tocHeadings.length} 节</span>
              <i
                class="iconfont icon-down sheet-chevron text-[10px] text-secondary"
                aria-hidden="true"
              />
            </summary>
            <ul class="max-h-[50vh] overflow-y-auto pb-2">
              {tocHeadings.map((heading) => (
                <li>
                  <a
                    class="flex min-h-9 items-center border-l border-primary text-[14px] leading-snug text-secondary transition-colors hover:text-accent-ink"
                    style={`padding-left: ${12 + Math.max(0, heading.depth - 2) * 12}px`}
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </header>

    <div class="py-10 grid lg:grid-cols-[minmax(0,1fr)_240px] gap-10 lg:gap-14">
      <div class="min-w-0 space-y-12">
        <MarkdownWrapper>
          <Content />
        </MarkdownWrapper>

        <section class="space-y-8 border-t border-primary pt-8">
          <PostCopyright
            title={current.data.title}
            slug={mdSlug}
            lastMod={lastMod}
            client:visible
          />
          <PostNav prev={prev} next={next} />
          {current.data.comments && <Comments />}
        </section>
      </div>

      <div class="hidden lg:block">
        <aside class="sticky top-20 space-y-8">
          <SectionBlock title="目录" index="T">
            <PostToc headings={headings} client:idle />
            <div class="mt-4 pt-3 border-t border-primary">
              <ReadingProgress client:idle />
            </div>
          </SectionBlock>
          <ActionAside client:idle />
        </aside>
      </div>
    </div>
  </div>
</MarkdownLayout>
