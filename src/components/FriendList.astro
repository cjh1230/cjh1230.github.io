---
import { getCollection } from 'astro:content'

const friends = await getCollection('friends')
---

<ul class="border-t border-primary grid sm:grid-cols-2 gap-x-10">
  {
    friends.map((friend) => (
      <li class="border-b border-primary">
        <a
          class="group flex items-center gap-3 py-3"
          href={friend.data.link}
          target="_blank"
          rel="noopener noreferrer external"
        >
          <img
            class="size-9 shrink-0 object-cover border border-primary"
            src={friend.data.avatar}
            alt=""
            width="36"
            height="36"
            loading="lazy"
          />
          <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-medium transition-colors group-hover:text-accent-ink">
              {friend.data.title}
            </div>
            <div class="truncate text-[11px] text-secondary">{friend.data.description}</div>
          </div>
          <span class="label shrink-0" aria-hidden>
            ↗
          </span>
        </a>
      </li>
    ))
  }
</ul>
