---
interface Props {
  title: string
  index?: string
}

const { title, index } = Astro.props
---

<section>
  <div class="mb-4 flex items-baseline gap-3 border-b border-primary pb-2">
    {index && <span class="label">{index}</span>}
    <h2 class="text-[13px] font-semibold tracking-wide">{title}</h2>
  </div>
  <slot />
</section>
