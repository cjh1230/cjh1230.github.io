---
interface Props {
  tags: {
    name: string
    slug: string
    count?: number
  }[]
}

const { tags } = Astro.props
---

{
  tags.length === 0 ? (
    <div class="text-sm text-secondary">暂无标签</div>
  ) : (
    <ul class="flex flex-wrap gap-x-3 gap-y-1.5 text-[13px] leading-relaxed">
      {tags.map((tag) => (
        <li>
          <a
            class="text-secondary transition-colors hover:text-accent-ink"
            href={`/tags/${tag.slug}`}
          >
            #{tag.name}
            {tag.count && <span class="mono num ml-1 text-[10px] opacity-60">{tag.count}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}
