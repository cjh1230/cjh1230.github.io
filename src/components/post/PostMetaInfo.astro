---
import { getIsoDate } from '@/utils/date'

interface Props {
  date: Date
  lastMod?: Date
  words: number
  readingMinutes: number
  class?: string
}

const { date, lastMod, words, readingMinutes, class: className } = Astro.props
---

<div
  class="flex flex-wrap items-center gap-x-4 gap-y-1 mono num text-[12px] text-secondary"
  class:list={[className]}
>
  <span>
    <span class="opacity-60">日期 </span>
    <time datetime={date.toISOString()}>{getIsoDate(date)}</time>
  </span>
  <span>
    <span class="opacity-60">字数 </span>
    {words}
  </span>
  <span>
    <span class="opacity-60">阅读 </span>
    {Math.ceil(readingMinutes)} min
  </span>
  {
    lastMod && (
      <span>
        <span class="opacity-60">编辑 </span>
        {getIsoDate(lastMod)}
      </span>
    )
  }
</div>
