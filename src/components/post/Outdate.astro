---
import { getDiffInDays, getIsoDate } from '@/utils/date'

interface Props {
  lastMod: Date
}

const { lastMod } = Astro.props
const isOutdated = getDiffInDays(lastMod) > 30
---

{
  isOutdated && (
    <div class="flex items-start gap-3 border border-primary px-3 py-2.5">
      <span class="label !text-primary shrink-0">Notice</span>
      <span class="text-xs leading-relaxed text-secondary">
        这篇文章最后修改于 {getIsoDate(lastMod)}
        ，部分内容可能已经不适用，如有疑问可联系作者。
      </span>
    </div>
  )
}
