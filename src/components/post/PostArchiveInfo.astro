---
import { slugify } from '@/utils/content'

interface Props {
  tags: string[]
  category?: string
  class?: string
}

const { tags, category, class: className } = Astro.props
---

<div
  class="flex flex-wrap items-center gap-x-3 gap-y-1 mono text-[12px] text-secondary"
  class:list={[className]}
>
  {
    category && (
      <a class="transition-colors hover:text-accent-ink" href={`/categories/${slugify(category)}`}>
        <span class="opacity-60">分类 </span>
        {category}
      </a>
    )
  }
  {
    tags.length > 0 && (
      <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="opacity-60">标签</span>
        {tags.map((tag) => (
          <a class="transition-colors hover:text-accent-ink" href={`/tags/${slugify(tag)}`}>
            #{tag}
          </a>
        ))}
      </span>
    )
  }
</div>
