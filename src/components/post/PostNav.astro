---
import type { CollectionEntry } from 'astro:content'

interface Props {
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
  class?: string
}

const { prev, next, class: className } = Astro.props
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-6" class:list={[className]}>
  <div>
    {
      prev && (
        <a class="group block" href={`/posts/${prev.slug}`}>
          <div class="label">上一篇</div>
          <div class="mt-1.5 flex items-baseline gap-2 text-sm transition-colors group-hover:text-accent-ink">
            <i class="iconfont icon-arrow-left shrink-0" aria-hidden />
            <span>{prev.data.title}</span>
          </div>
        </a>
      )
    }
  </div>
  <div class="sm:text-right">
    {
      next && (
        <a class="group block" href={`/posts/${next.slug}`}>
          <div class="label">下一篇</div>
          <div class="mt-1.5 inline-flex items-baseline gap-2 text-sm transition-colors group-hover:text-accent-ink">
            <span>{next.data.title}</span>
            <i class="iconfont icon-arrow-right shrink-0" aria-hidden />
          </div>
        </a>
      )
    }
  </div>
</div>
