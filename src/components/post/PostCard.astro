---
import type { CollectionEntry } from 'astro:content'
import { getIsoDate } from '@/utils/date'

interface Props {
  entry: CollectionEntry<'posts'>
  index?: number
}

const { entry, index = 0 } = Astro.props

const { remarkPluginFrontmatter } = await entry.render()
const tags = entry.data.tags.slice(0, 3)
const words = remarkPluginFrontmatter.words as number
---

<a
  class="group relative grid grid-cols-[40px_1fr] md:grid-cols-[56px_1fr_auto] gap-x-4 py-6 border-b border-primary transition-colors reveal"
  href={`/posts/${entry.slug}`}
  style={`--i: ${index}`}
>
  <div
    class="mono num pt-1 text-[11px] text-secondary transition-colors group-hover:text-accent-ink"
    aria-hidden
  >
    {String(index + 1).padStart(3, '0')}
  </div>

  <div class="min-w-0">
    <h2
      class="text-lg md:text-xl font-semibold leading-snug tracking-tight text-balance transition-colors group-hover:text-accent-ink"
    >
      {entry.data.title}
      {
        entry.data.sticky > 0 && (
          <i
            class="ml-2 align-middle iconfont icon-pushpin text-accent-ink text-sm"
            aria-label="置顶"
          />
        )
      }
    </h2>

    {
      entry.data.summary && (
        <p class="mt-1.5 text-sm leading-relaxed text-secondary line-clamp-2">
          {entry.data.summary}
        </p>
      )
    }

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5 mono text-[12px] text-secondary">
      <time class="num" datetime={entry.data.date.toISOString()}>{getIsoDate(entry.data.date)}</time
      >
      <span class="num">{Math.ceil(remarkPluginFrontmatter.readingMinutes)} min</span>
      <span class="num">{words >= 1000 ? `${(words / 1000).toFixed(1)}k` : words} 字</span>
      <span class="inline-flex flex-nowrap items-center gap-x-2">
        {
          tags.map((tag, i) => (
            <span class:list={['opacity-70', { 'hidden sm:inline': i === 2 }]}>#{tag}</span>
          ))
        }
        {
          entry.data.tags.length > 2 && (
            <span class="opacity-70 sm:hidden">+{entry.data.tags.length - 2}</span>
          )
        }
      </span>
    </div>
  </div>

  {
    entry.data.cover && (
      <div class="hidden md:block">
        <img
          class="size-24 object-cover border border-primary"
          src={entry.data.cover}
          alt=""
          width="96"
          height="96"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</a>
