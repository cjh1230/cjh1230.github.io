---
import { getCollection } from 'astro:content'

const projects = await getCollection('projects')

function hostOf(link: string) {
  try {
    return new URL(link).hostname.replace(/^www\./, '')
  } catch {
    return ''
  }
}
---

<ul class="border-t border-primary">
  {
    projects.map((project, i) => (
      <li class="border-b border-primary">
        <a
          class="group flex gap-4 md:gap-6 py-5"
          href={project.data.link}
          target="_blank"
          rel="noopener noreferrer external"
        >
          <span class="mono num w-7 shrink-0 pt-1 text-[12px] text-secondary" aria-hidden>
            {String(i + 1).padStart(3, '0')}
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg font-semibold tracking-tight transition-colors group-hover:text-accent-ink">
                {project.data.title}
              </h2>
              <span class="mono shrink-0 text-[11px] text-secondary">
                {hostOf(project.data.link)} ↗
              </span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-secondary line-clamp-2">
              {project.data.description}
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ul>
