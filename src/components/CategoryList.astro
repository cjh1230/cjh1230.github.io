---
interface Props {
  categories: {
    name: string
    slug: string
    count: number
  }[]
}

const { categories } = Astro.props
---

{
  categories.length === 0 ? (
    <div class="text-sm text-secondary">暂无分类</div>
  ) : (
    <ul class="space-y-1.5">
      {categories.map((category) => (
        <li>
          <a class="group flex items-baseline text-[13px]" href={`/categories/${category.slug}`}>
            <span class="transition-colors group-hover:text-accent-ink">{category.name}</span>
            <span class="leader" aria-hidden />
            <span class="mono num text-[11px] text-secondary">{category.count}</span>
          </a>
        </li>
      ))}
    </ul>
  )
}
