---
import type { CollectionEntry } from 'astro:content'
import { getIsoDate } from '@/utils/date'

interface Props {
  posts: CollectionEntry<'posts'>[]
}

const { posts } = Astro.props

const groupedPosts = posts.reduce<
  {
    year: number
    posts: CollectionEntry<'posts'>[]
  }[]
>((acc, cur) => {
  const year = cur.data.date.getFullYear()
  const lastYearGroup = acc[acc.length - 1]
  if (lastYearGroup && lastYearGroup.year === year) {
    lastYearGroup.posts.push(cur)
  } else {
    acc.push({
      year,
      posts: [cur],
    })
  }
  return acc
}, [])
---

<section>
  {
    groupedPosts.map((year) => (
      <div class="grid grid-cols-[56px_1fr] md:grid-cols-[96px_1fr] gap-4 md:gap-8 border-t border-primary py-7">
        <div class="mono num text-xl font-bold tracking-tight">{year.year}</div>
        <ul>
          {year.posts.map((post) => (
            <li class="border-b border-primary last:border-b-0">
              <a class="group flex items-baseline gap-4 py-2.5" href={`/posts/${post.slug}`}>
                <time
                  class="mono num w-10 shrink-0 text-[11px] text-secondary"
                  datetime={post.data.date.toISOString()}
                >
                  {getIsoDate(post.data.date).slice(5)}
                </time>
                <span class="text-[15px] leading-snug transition-colors group-hover:text-accent-ink">
                  {post.data.title}
                </span>
                {post.data.sticky > 0 && (
                  <i class="iconfont icon-pushpin text-sm text-accent-ink" aria-label="置顶" />
                )}
                <span class="leader hidden sm:block" aria-hidden />
                <span class="label hidden shrink-0 sm:block">阅读 →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>
