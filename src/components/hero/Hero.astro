---
import { hero } from '@/config.json'
import { getAllCategories, getAllPostsWordCount, getSortedPosts } from '@/utils/content'
import { getIsoDate } from '@/utils/date'

const posts = await getSortedPosts()
const wordCount = await getAllPostsWordCount()
const categories = await getAllCategories()

const pad = (n: number) => String(n).padStart(2, '0')
const latest = posts[0]?.data.date ?? new Date()
const revision = `${latest.getFullYear()}.${pad(latest.getMonth() + 1)}`

// Only fields a reader can act on: freshness, volume, breadth.
const specs = [
  { label: 'Updated', value: getIsoDate(latest) },
  { label: 'Entries', value: String(posts.length) },
  { label: 'Topics', value: String(categories.length) },
]
---

<section class="border-b border-primary">
  <div class="max-w-[1200px] mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-[1fr_320px]">
      <div class="py-8 lg:py-12 lg:pr-12">
        <div class="flex items-center gap-3">
          <span class="label">Doc. CIN-001</span>
          <span class="h-px flex-1 bg-[rgb(var(--color-border-primary))]" aria-hidden></span>
          <span class="label">Rev. {revision}</span>
        </div>

        <h1
          class="mt-6 text-[clamp(2.75rem,7vw,4.5rem)] font-bold leading-[0.92] tracking-[-0.04em]"
        >
          cin
        </h1>
        <p class="mt-4 text-lg md:text-xl tracking-tight">让机器看见世界。</p>
        <p class="mt-2 max-w-[52ch] text-sm leading-relaxed text-secondary">
          {hero.description}
        </p>

        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
          {
            hero.socials.map((social) => (
              <li>
                <a
                  class="mono text-[11px] uppercase tracking-[0.08em] text-secondary transition-colors hover:text-accent-ink"
                  href={social.url}
                  target={social.url.startsWith('http') ? '_blank' : undefined}
                  rel={social.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {social.name}
                  <span aria-hidden class="ml-1 opacity-60">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div
          class="mt-5 flex flex-wrap gap-x-4 gap-y-1 mono num text-[12px] text-secondary lg:hidden"
        >
          <span>{posts.length} 篇</span>
          <span aria-hidden class="opacity-40">/</span>
          <span>{categories.length} 主题</span>
          <span aria-hidden class="opacity-40">/</span>
          <span>更新 {getIsoDate(latest)}</span>
        </div>
      </div>

      <aside class="hidden lg:block border-t border-primary lg:border-t-0 lg:border-l">
        <div class="py-8 lg:py-12 lg:pl-8">
          <dl class="border-t border-primary">
            {
              specs.map((spec) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-primary py-2.5">
                  <dt class="label">{spec.label}</dt>
                  <dd class="mono num text-[12px] text-right">{spec.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-xs leading-relaxed text-secondary">
            共 {(wordCount / 1000).toFixed(1)}k 字 · 最新
            <span class="mono num whitespace-nowrap">{getIsoDate(latest)}</span>
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>
